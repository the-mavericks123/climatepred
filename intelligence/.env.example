# Climate Eye View — Environment Configuration Template
# Copy this file to .env and customize. Never commit active credentials.

# Service Network Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
JSON_LOGGING=false

# Security & Secrets (MANDATORY: Override in production)
SECRET_KEY=change-me-in-production-use-a-secure-random-32-byte-key
ALLOWED_ORIGINS=["http://localhost:4173","http://127.0.0.1:4173","http://localhost:5173"]

# API Authentication & Authorization
API_AUTH_ENABLED=false
ADMIN_API_KEY=adm-secret-key-placeholder-32-chars-min
OPERATOR_API_KEY=op-secret-key-placeholder-32-chars-min

# Rate Limiting & Resource Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
MAX_REQUEST_BODY_BYTES=10485760

# Timeouts & Resilience
EXTERNAL_SERVICE_TIMEOUT_SEC=5.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SEC=30.0

# Freshness & Data Retention
DATA_FRESHNESS_THRESHOLD_SEC=300
MODEL_CONFIG_DIR=intelligence/models

# Feature Flags
ENABLE_DETAILED_PROVENANCE=true
ENABLE_INGESTION_VALIDATION=true
ENABLE_SIMULATION_STUBS=false

# Database & Broker Connectivity (Docker Compose default addresses)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_DB=climate_eye_view
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_password_change_me@postgis:5432/climate_eye_view

MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_CLIENT_ID=climate_eye_view_backend
MQTT_USERNAME=
MQTT_PASSWORD=
